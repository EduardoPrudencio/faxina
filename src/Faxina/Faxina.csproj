<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Gerado por tools/make-icon.ps1 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>Faxina</AssemblyTitle>
    <Product>Faxina</Product>
    <Version>1.2.0</Version>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <!-- O pacote do WebView2 traz uma DLL de WPF que não usamos e gera conflito de WindowsBase. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Management" Version="10.0.14" />
  </ItemGroup>

  <!-- Versão portátil: dotnet publish -p:Portable=true (ver tools/publish.ps1). -->
  <PropertyGroup Condition="'$(Portable)' == 'true'">
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
    <AssemblyName>Faxina-portatil</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Varredura, limpezas comuns, ponte e a interface web (embutida) ficam no Faxina.Core. -->
    <ProjectReference Include="..\Faxina.Core\Faxina.Core.csproj" />
  </ItemGroup>

</Project>
