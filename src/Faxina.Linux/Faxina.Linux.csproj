<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Faxina para Linux: um servidor HTTP local (só em 127.0.0.1) que abre a mesma interface no navegador.
    Sem dependências gráficas: roda em qualquer distribuição, inclusive servidores sem tela (via túnel SSH).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>faxina</AssemblyName>
    <RootNamespace>Faxina.Linux</RootNamespace>
    <Version>1.1.0</Version>
    <!-- Não exige libicu no sistema; a formatação pt-BR é feita à mão (Br.Size/Br.Count). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Faxina.Core\Faxina.Core.csproj" />
  </ItemGroup>

</Project>
